<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Corrections</title>

<style>
body {
    font-family: Arial;
    background: #0f172a;
    color: white;
    text-align: center;
}
</style>
</head>

<body>

<h1 data-key="corr_title">✅ Corrections</h1>
<p data-key="corr_text">Vérifie tes réponses ici</p>

<a href="index.html" data-key="back">⬅ Retour</a>

<script>
const translations = {
    fr: {
        corr_title: "✅ Corrections",
        corr_text: "Vérifie tes réponses ici",
        back: "⬅ Retour"
    },
    en: {
        corr_title: "✅ Corrections",
        corr_text: "Check your answers here",
        back: "⬅ Back"
    }
};

function setLang(lang){
    localStorage.setItem("lang", lang);

    document.querySelectorAll("[data-key]").forEach(el=>{
        let key = el.getAttribute("data-key");
        el.innerText = translations[lang][key];
    });
}

window.onload = ()=>{
    setLang(localStorage.getItem("lang") || "fr");
}
</script>

</body>
</html>
